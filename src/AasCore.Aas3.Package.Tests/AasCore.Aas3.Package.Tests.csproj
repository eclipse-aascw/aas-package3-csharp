<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <IsPackable>false</IsPackable>

        <Configurations>Debug;Release;DebugSlow</Configurations>

        <Platforms>AnyCPU</Platforms>

        <Nullable>enable</Nullable>

        <TargetFrameworks>net9.0;net8.0</TargetFrameworks>

        <OutputType>Library</OutputType>

        <LangVersion>8</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <DefineConstants>TRACECOREAPP</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NUnit" Version="5.0.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    </ItemGroup>
    
    <ItemGroup>
      <ProjectReference Include="..\AasCore.Aas3.Package\AasCore.Aas3.Package.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="TestResources\**">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>
</Project>
