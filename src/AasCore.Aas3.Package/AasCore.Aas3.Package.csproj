<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;netstandard2.1;netstandard2.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <Configurations>Debug;Release;DebugSlow</Configurations>
        <Platforms>AnyCPU</Platforms>
        <LangVersion>8</LangVersion>

        <PackageId>AasCore.Aas3.Package</PackageId>
        <Version>2.0.0</Version>
        <Authors>Marko Ristin, Nico Braunisch, Aaron Zielstorff, Tobias Langer</Authors>
        <Description>
            A library for reading and writing packaged file format of an Asset Administration Shell (AAS) v3
        </Description>
        <RepositoryUrl>https://github.com/eclipse-aascw/aas-package3-csharp.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Copyright>Copyright (c) 2023 aas-package3-csharp AUTHORS</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/eclipse-aascw/aas-package3-csharp</PackageProjectUrl>
        <PackageTags>aas;asset administration shell;iiot;industry internet of things;industrie 4.0;i4.0</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.IO.Packaging" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
